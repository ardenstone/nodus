# Copy to `.env` and adjust as needed: `cp .env.example .env`

# --- PostgreSQL ---
POSTGRES_USER=nodus
POSTGRES_PASSWORD=nodus
POSTGRES_DB=nodus
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Host port mappings (docker-compose) ---
BACKEND_PORT=8000

# --- Backend database connection ---
# Inside docker-compose the host is the service name `db`.
DATABASE_URL=postgresql+psycopg://nodus:nodus@localhost:5432/nodus

# --- LLM (OpenAI-compatible endpoint) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed
LLM_MODEL=llama3.1

# --- Embeddings ---
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
